# ============================================================
# Production environment -- lives ONLY on the server as `.env`
# (docker-compose.prod.yml reads it via `env_file: .env`). Never commit
# the real file. Copy this to `.env` on the server and adjust the
# CORS_ORIGINS/VITE_*_URL values once you have a domain.
# ============================================================

# ---------- App ----------
APP_ENV=production
# Generate your own -- never reuse the example below in a real
# deployment: `python3 -c "import secrets; print(secrets.token_hex(32))"`
APP_SECRET_KEY=change-me-generate-a-real-64-char-hex-secret
APP_DEBUG=false
# Update once you have a domain -- until then, the server's own public IP
# is what the frontend is actually served from, so it must be listed here
# too or the browser's CORS check rejects every API call.
CORS_ORIGINS=http://YOUR_SERVER_IP

# ---------- Database ----------
POSTGRES_USER=docai
# Generate your own: `python3 -c "import secrets; print(secrets.token_urlsafe(24))"`
POSTGRES_PASSWORD=change-me-generate-a-real-random-password
POSTGRES_DB=document_clean_reconstruct

# ---------- Storage ----------
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/app/storage

# ---------- Upload limits ----------
MAX_UPLOAD_SIZE_MB=500
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.jpg,.jpeg,.png,.webp

# ---------- Page rendering ----------
DEFAULT_DPI=150
PREPROCESS_PROFILE=FAST

# ---------- OCR ----------
OCR_PROVIDER=paddleocr
PADDLE_OCR_LANGS=en,hi
TESSERACT_PATH=/usr/bin/tesseract
TESSERACT_LANGS=eng+hin
ENABLE_PP_STRUCTURE=false
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/neva-22b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

# ---------- Workers ----------
# One document pipeline at a time per worker container -- see
# .env.example's fuller explanation. Scale worker CONTAINERS
# (docker compose -f docker-compose.prod.yml up -d --scale worker=N) for
# multi-document throughput instead of raising this.
CELERY_WORKER_CONCURRENCY=1
OCR_WORKERS=0
OCR_MAX_WORKERS=10
OCR_MIN_WORKERS=1
# Tuned for a 2-vCPU server (m7i-flex.large/similar) -- .env.example's
# default of 3 would leave 0 cores for OCR on a box this small. Raise
# this back toward 2-3 if you move to a 4+ vCPU instance.
OCR_RESERVED_CPU=1
OCR_RESERVED_MEMORY_MB=1536
# Measured on a real document (2026-09-15): ~4.8GB/worker sustained with
# PADDLE_OCR_LANGS=en,hi. Re-measure if you change that.
OCR_WORKER_EST_MEMORY_MB=4800
OCR_AUTO_FALLBACK=true
OCR_WORKER_MAX_PAGES=25
MAX_AI_CONCURRENCY=2
OCR_QUEUE_SIZE=0
OCR_TASK_TIMEOUT_SECONDS=180
OCR_RETRY_COUNT=2

# ---------- Library accession register ----------
ACCESSION_NUMBER_PREFIX=D
ACCESSION_NUMBER_START=1

# ---------- Native thread-pool pinning ----------
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1

# ---------- Image tags (docker-compose.prod.yml) ----------
# Which published GHCR images to run -- the GitHub Actions deploy step
# overrides IMAGE_TAG per deploy; left at `latest` here for a manual
# `docker compose -f docker-compose.prod.yml up -d` on the server.
BACKEND_IMAGE=ghcr.io/abhiroy00/ocr-book-backend
FRONTEND_IMAGE=ghcr.io/abhiroy00/ocr-book-frontend
IMAGE_TAG=latest
