# Env
.env
.env.*
!.env.example
!.env.prod.example

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
backend/.venv/

# Node
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*

# Storage (runtime data, never commit)
storage/original/*
storage/pages/*
storage/processed/*
storage/ocr/*
storage/output/*
storage/tmp/*
!storage/**/.gitkeep

# Same, but for backend/storage/ -- the default STORAGE_LOCAL_ROOT ("./storage")
# resolves here when the backend runs with its CWD at backend/ (e.g. `pytest`
# run directly on the host, outside Docker) instead of /app/storage inside the
# container, and has repeatedly left real test-run image output un-ignored.
backend/storage/

# Claude Code's own local session config -- personal/machine-specific tool
# permissions, not project source.
.claude/

# OCR / model caches
.paddleocr/
**/.paddlex/

# Fetched fonts (backend/scripts/fetch_fonts.sh) — not committed, needed on
# the host because docker-compose's bind mount shadows whatever the
# Dockerfile downloaded at image build time; see that script's header.
backend/app/reconstruction/fonts/*.ttf

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Docker
docker/**/*.pyc
