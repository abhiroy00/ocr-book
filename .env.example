# ============================================================
# Document Clean & Reconstruct AI — environment configuration
# Copy to .env and adjust. Never commit the real .env file.
# ============================================================

# ---------- App ----------
APP_ENV=development                 # development | production
APP_SECRET_KEY=change-me-to-a-random-64-char-string
APP_DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Database ----------
POSTGRES_USER=docai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=document_clean_reconstruct
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://docai:change-me@postgres:5432/document_clean_reconstruct

# ---------- Redis / Celery ----------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---------- Storage ----------
STORAGE_BACKEND=local                # local | s3
STORAGE_LOCAL_ROOT=/app/storage
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# ---------- Upload limits ----------
MAX_UPLOAD_SIZE_MB=500
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.jpg,.jpeg,.png,.webp

# ---------- Page rendering ----------
DEFAULT_DPI=150
PREPROCESS_PROFILE=FAST

# ---------- OCR ----------
OCR_PROVIDER=paddleocr               # paddleocr|tesseract|nvidia|ollama
PADDLE_OCR_LANGS=en,hi
TESSERACT_PATH=/usr/bin/tesseract
TESSERACT_LANGS=eng+hin
# Optional, highest-quality table structure model (spec section 12). Off by
# default: its native inference has been observed to hard-crash (SIGILL) on
# some CPU/virtualization setups where the prebuilt paddlepaddle wheel
# doesn't match the host's instruction set. The OpenCV-line + OCR-alignment
# table engines (always on) are the fully-supported default path. Only
# enable this after confirming PaddleOCR itself runs cleanly for you.
ENABLE_PP_STRUCTURE=false

# NVIDIA VLM (optional — app works fully without these)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/neva-22b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Ollama (optional — local LLM for layout/structure suggestions only)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

# ---------- Workers ----------
# Keep at 1: total OS processes doing OCR = CELERY_WORKER_CONCURRENCY x
# OCR_WORKERS (each concurrent document job runs its own OCR_WORKERS-sized
# pool). At 1, all of OCR_WORKERS' parallelism goes into whichever single
# document is currently processing, which is what "process one large
# document fast" needs. To process multiple documents at once, scale
# worker CONTAINERS instead (`docker compose up -d --scale worker=N`) --
# each replica is independently resource-bounded by Docker/the OS, unlike
# multiplying this in-process value.
CELERY_WORKER_CONCURRENCY=1

# Controlled page-level OCR parallelism (NOT one process per page -- see
# app/workers/page_worker_pool.py). 0 = auto: computed fresh at pipeline
# start from real CPU AND actually-available RAM (see
# app.core.config.Settings.resolved_ocr_workers), capped at OCR_MAX_WORKERS
# -- never a blind constant, since each worker holds its own loaded OCR
# model (real, non-shareable memory).
OCR_WORKERS=0
OCR_MAX_WORKERS=10
OCR_MIN_WORKERS=1
# Cores held back for Postgres/Redis/the web server -- never handed to OCR.
OCR_RESERVED_CPU=3
# RAM (MB) held back for everything else sharing this host before sizing
# the OCR pool.
OCR_RESERVED_MEMORY_MB=1536
# Per-worker memory estimate (MB) -- measure this on your own host/
# PADDLE_OCR_LANGS configuration over a FULL run (10+ pages; a short run
# undercounts -- memory keeps climbing as PaddleOCR warms up) rather than
# trusting the default blindly. Reference data point: 2 languages (en+hi)
# loaded per worker measured at ~4.5GB/worker sustained on one host.
OCR_WORKER_EST_MEMORY_MB=4800
# false bypasses the RAM-aware sizing above and honors OCR_WORKERS
# literally -- only for an operator who has already sized their own host.
OCR_AUTO_FALLBACK=true
# Separate, much smaller concurrency cap for NVIDIA AI-fallback calls
# specifically -- OCR_WORKERS parallelism must never translate into that
# many simultaneous external API requests.
MAX_AI_CONCURRENCY=2
OCR_QUEUE_SIZE=0
OCR_TASK_TIMEOUT_SECONDS=180
OCR_RETRY_COUNT=2

# ---------- Native thread-pool pinning (defense in depth) ----------
# Prevents numpy/scipy/OpenBLAS/MKL from each defaulting to "use every
# core" independently of the process-level parallelism above -- keeps
# OCR_WORKERS the sole source of concurrency, avoiding a repeat of a
# confirmed thread-oversubscription collapse (2 pool workers at library
# defaults: per-page OCR time went from ~4s to over 1150s).
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# ---------- Host port overrides (docker-compose.yml) ----------
# Only needed if the defaults below collide with something else already
# running on your machine (another project's containers, a local Postgres,
# etc). Change the left-hand side only — the container-internal ports
# never change, so nothing else in this file needs to match.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
NGINX_HOST_PORT=80
OLLAMA_HOST_PORT=11434
